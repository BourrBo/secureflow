# Copy this to backend/.env.docker and fill in real values, then run
# `docker compose up --build` from the repo root.
#
# Same values as backend/.env.example — kept as a separate file/name so it
# never gets picked up by a non-Docker local run by accident, and so it's
# obviously not the file with your real local secrets in it.

# Supabase project — Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase project — Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" connection string for a long-running backend.
DATABASE_URL=

# Leave unset — the Docker image already has zap.sh on PATH via the
# symlink in backend/Dockerfile, so auto-discovery finds it without this.
# ZAP_PATH=

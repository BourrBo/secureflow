# Copy to backend/.env for a non-Docker (bare Python) local run.
# See .env.docker.example for the Docker-run version of this file.

# ── Required — app won't boot correctly without these ──────────────────
# Supabase project — Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase project — Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" connection string for a long-running backend.
DATABASE_URL=

# ── Optional — source control integrations ──────────────────────────────
# Leave any of these blank to simply disable that provider's integration;
# nothing crashes, the "Connect" button for that provider just won't work.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=
GITLAB_URL=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_REDIRECT_URI=

# Required only if you use the integrations above: encrypts stored OAuth
# tokens at rest. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTEGRATIONS_ENCRYPTION_KEY=
# Where OAuth redirects back to after a provider callback (your frontend URL)
INTEGRATIONS_FRONTEND_URL=http://localhost:3000
# Optional: separate DB URL for integrations tables; falls back to DATABASE_URL
# INTEGRATIONS_DATABASE_URL=

# ── Optional — DAST / ZAP tuning ────────────────────────────────────────
# Leave unset in Docker — the image already has zap.sh on PATH via the
# symlink in backend/Dockerfile, so auto-discovery finds it without this.
# ZAP_PATH=
# ZAP_HOST=127.0.0.1
# ZAP_PORT=8080
# ZAP_AUTOSTART=true
# ZAP_API_KEY=
# DAST_ACTIVE_SCAN_STALL_TIMEOUT_SECONDS=
# Only enable this for controlled internal testing — allows DAST scans
# against private/internal IP ranges.
# ALLOW_PRIVATE_DAST_TARGETS=false

# ── Optional — local SQLite fallback (legacy, pre-Supabase) ────────────
# SECUREFLOW_DB=
